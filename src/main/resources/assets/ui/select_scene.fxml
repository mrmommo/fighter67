<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.ImageView?>

<StackPane prefWidth="1920" prefHeight="1080" stylesheets="@styles.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    
    <Rectangle width="1920" height="1080" fill="rgba(0, 0, 0, 0.7)"/>
    
    <VBox alignment="CENTER" spacing="30" translateX="250">
        
        <Text fx:id="mapNameText" styleClass="select-map-name" />
        
        <HBox alignment="CENTER" spacing="50">
            <!-- btnPrev -->
            <StackPane fx:id="btnPrev" maxWidth="160" maxHeight="50" styleClass="forest-btn">
                <Polygon styleClass="forest-btn-bg-solid" points="20.0,0.0,160.0,0.0,140.0,50.0,0.0,50.0" />
                <Polygon styleClass="forest-btn-accent" StackPane.alignment="CENTER_LEFT" points="20.0,0.0,26.0,0.0,6.0,50.0,0.0,50.0" />
                <Text text="◄ PREV" styleClass="forest-btn-text" />
            </StackPane>
            
            <ImageView fx:id="mapPreview" fitWidth="800" fitHeight="450" preserveRatio="true"/>
            
            <!-- btnNext -->
            <StackPane fx:id="btnNext" maxWidth="160" maxHeight="50" styleClass="forest-btn">
                <Polygon styleClass="forest-btn-bg-solid" points="20.0,0.0,160.0,0.0,140.0,50.0,0.0,50.0" />
                <Polygon styleClass="forest-btn-accent" StackPane.alignment="CENTER_LEFT" points="20.0,0.0,26.0,0.0,6.0,50.0,0.0,50.0" />
                <Text text="NEXT ►" styleClass="forest-btn-text" />
            </StackPane>
        </HBox>
        
        <Text text="CHẾ ĐỘ CHƠI" styleClass="select-mode-title" />
        
        <HBox alignment="CENTER" spacing="20">
            <!-- btnModePrev -->
            <StackPane fx:id="btnModePrev" maxWidth="80" maxHeight="50" styleClass="forest-btn">
                <Polygon styleClass="forest-btn-bg-solid" points="20.0,0.0,80.0,0.0,60.0,50.0,0.0,50.0" />
                <Polygon styleClass="forest-btn-accent" StackPane.alignment="CENTER_LEFT" points="20.0,0.0,26.0,0.0,6.0,50.0,0.0,50.0" />
                <Text text="◄" styleClass="forest-btn-text" />
            </StackPane>
            
            <Text fx:id="modeNameText" styleClass="select-mode-name" />
            
            <!-- btnModeNext -->
            <StackPane fx:id="btnModeNext" maxWidth="80" maxHeight="50" styleClass="forest-btn">
                <Polygon styleClass="forest-btn-bg-solid" points="20.0,0.0,80.0,0.0,60.0,50.0,0.0,50.0" />
                <Polygon styleClass="forest-btn-accent" StackPane.alignment="CENTER_LEFT" points="20.0,0.0,26.0,0.0,6.0,50.0,0.0,50.0" />
                <Text text="►" styleClass="forest-btn-text" />
            </StackPane>
        </HBox>
        
        <!-- btnGo -->
        <StackPane fx:id="btnGo" maxWidth="300" maxHeight="50" styleClass="forest-btn">
            <Polygon styleClass="forest-btn-bg-solid" points="20.0,0.0,300.0,0.0,280.0,50.0,0.0,50.0" />
            <Polygon styleClass="forest-btn-accent" StackPane.alignment="CENTER_LEFT" points="20.0,0.0,26.0,0.0,6.0,50.0,0.0,50.0" />
            <Text text="🚀 START BATTLE" styleClass="forest-btn-text" />
        </StackPane>
        
    </VBox>
</StackPane>
